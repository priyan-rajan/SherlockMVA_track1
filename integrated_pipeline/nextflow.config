params {
    root          = projectDir
    outdir        = "${projectDir}/results"

    // inputs (archived upstream outputs + shared raw data)
    vcf           = "${projectDir}/inputs/WGS_EX2312012_HGWCNDSX7.vcf.gz"
    exomiser_genes    = "${projectDir}/inputs/exomiser/WGS_EX2312012.genes.tsv"
    genomiser_genes   = "${projectDir}/inputs/genomiser/WGS_EX2312012_genomiser.genes.tsv"
    panel_bed         = "${projectDir}/inputs/panel/panel.bed"
    panel_by_gene     = "${projectDir}/inputs/panel/panel_by_gene.tsv"
    panel_archived    = "${projectDir}/inputs/panel/panel_screen_impactful_variants.tsv"
    acmg_sf           = "${projectDir}/inputs/acmg/ACMG_SF_3.2.tsv"
    svcnv             = "${projectDir}/inputs/svcnv/sv_cnv_gene_level_tiered.tsv"

    // reporting
    proband_id        = "PROBAND01"
    chrom_prefix      = "chr"
    primary_gene      = "BUB1B"
    // secondary lead verified independently: "locus label"
    secondary_locus   = "22:20996720"
    secondary_label   = "LZTR1_secondary"
}

workDir = "${projectDir}/work"

process {
    executor      = 'local'
    cpus          = 2
    memory        = '4 GB'
    errorStrategy = 'terminate'
    maxForks      = 2
}

executor {
    name      = 'local'
    queueSize = 2
}

profiles {
    local      { process { executor = 'local' } }
    rerun_note { /* see bin/00_rerun_upstream.sh — regenerate inputs/ from raw data */ }
}

timeline { enabled = true; file = "${params.outdir}/timeline.html" }
report   { enabled = true; file = "${params.outdir}/report.html" }
trace    { enabled = true; file = "${params.outdir}/trace.txt"; fields = 'task_id,name,status,exit,realtime' }
