// ============================================================================
// nextflow.config — Carolina Cloud `ccloud` executor for the MVA WGS run
// ============================================================================
// This machine is ONLY the Nextflow driver. Every pipeline task (bwa, manta,
// cnvkit, gatk, ...) runs on Carolina Cloud pool workers, sized per-process.
//
// Source: https://docs.carolinacloud.io/nextflow/ and
//         https://console.carolinacloud.io/static/nextflow/local-quickstart.md
//
// Storage rule (IMPORTANT): Nextflow talks to ONE S3 endpoint per run, and the
// pipeline-bucket credentials are scoped to that one bucket. The CC pipeline
// bucket is Cloudflare R2 (*.r2.cloudflarestorage.com) — a DIFFERENT endpoint
// from the org Wasabi bucket. So workDir, --input and --outdir must all live in
// the pipeline bucket. The org Wasabi bucket cannot be read mid-run.
//
// The AWS_* variables on this box currently point at the org Wasabi bucket.
// Do NOT overwrite them globally; export the pipeline-bucket (R2) credentials
// in the shell that launches this run (see run_sarek.sh / setup_env.sh).
// ============================================================================

plugins {
    // Pin the pipeline's own plugins to what nf-core/sarek 3.5.1 expects.
    // If left unpinned, Nextflow resolves nf-schema to latest (3.x), which
    // dropped paramsSummaryLog() -> the pipeline dies at startup. Plus our
    // ccloud executor plugin.
    id 'nf-schema@2.2.1'
    id 'nf-prov@1.2.2'
    id 'nf-ccloud@1.0.2'
}
process.executor = 'ccloud'

ccloud {
    apiKey   = secrets.CCLOUD_API_KEY            // set via: nextflow secrets set CCLOUD_API_KEY <key>
    endpoint = 'https://console.carolinacloud.io'

    // WGS tuning: keep workers warm across bursty stages, and cache large
    // intermediates (a 100-150 GiB BAM won't fit the 20 GiB default cache).
    // Keep workers lean so more fit under the account's aggregate cap.
    // (CC docs: cacheBudgetGib is reserved up-front on EVERY worker, so a
    //  large value starves parallelism -> the pool can't grow past 1 worker.)
    idleTimeout    = '5min'
    cacheBudgetGib = 20
    // poolMax default is 64 workers/run; raise once we know the account quota.
}

params {
    // The Carolina Cloud Nextflow pipeline bucket (Cloudflare R2). Fill in
    // after provisioning (see README: provision-nextflow-bucket is idempotent).
    bucket = 'wandering-cloud-583'
}

workDir = "s3://${params.bucket}/mva-sarek/work/"

aws {
    accessKey = System.getenv('AWS_ACCESS_KEY_ID')      // MUST be the R2 pipeline-bucket keys
    secretKey = System.getenv('AWS_SECRET_ACCESS_KEY')
    region    = 'auto'
    client { endpoint = System.getenv('AWS_ENDPOINT_URL') }
}

// Let tasks retry onto bigger workers, but do NOT force a heavy global floor:
// a 16 GiB RAM / 50 GiB disk minimum on every worker (even tiny ones) starves
// parallelism under an account aggregate cap. Sarek declares its own
// per-process resources, so keep this minimal.
process {
    errorStrategy = 'retry'
    maxRetries    = 3
    disk          = '100 GB'                                   // replaces ccloud's 50 GiB default
    // Sizes lowered 2026-10-15: CC has no numeric disk cap, but oversized workers
    // (500 GB) could not be placed -> permanent `can't grow (429)`. Real need for
    // MarkDuplicates is ~84 GiB input + ~90 GiB output ~= 175 GiB. See
    // DIAGNOSIS_markduplicates_2026-10-15.md. cacheBudgetGib (ccloud block) adds
    // +20 GiB on top of each worker's scratch disk.
    withName: 'GATK4_MARKDUPLICATES|GATK4SPARK_MARKDUPLICATES' { disk = '200 GB' }
    withName: 'MANTA.*|STRELKA.*|TIDDIT.*'                     { disk = '200 GB' }
    withName: 'CNVKIT_.*'                                      { disk = '150 GB' }
    withName: 'SAMTOOLS_.*|MOSDEPTH|MULTIQC'                   { disk = '100 GB' }
    // Final QC tail (VCF stats on the SNV VCF) stalled in `can't grow (429)` at
    // 100 GB. These are tiny tasks; ask for a small worker so it can fit a slot.
    withName: 'VCFTOOLS_.*|BCFTOOLS_.*'                        { disk = '20 GB' }
}
